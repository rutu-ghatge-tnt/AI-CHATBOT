# Production catalog — use skin_bb @ 10.0.128.233 (VPC) or SSH tunnel to localhost.

# Direct (VPC/VPN only):
# PRODUCTION_MONGO_URI=mongodb://skinbb:REPLACE@10.0.128.233:27017/skin_bb

# SSH tunnel example (from laptop):
#   ssh -L 27018:10.0.128.233:27017 user@bastion
# PRODUCTION_MONGO_URI=mongodb://skinbb:REPLACE@127.0.0.1:27018/skin_bb

# HLHP Goals integration (event hub on skinbb-main-backend)
# HLHP_HUB_URL=https://api.skinbb.com/api/v1/hlhp/hub
# HLHP_NODE_API_URL=https://api.skinbb.com
# HLHP_SERVICE_API_KEY=replace-with-shared-service-key
# HLHP_PLUS_DEFAULT_FEE_INR=1499
# HLHP_SELFIE_STORAGE_DIR=data/hlhp-selfies
