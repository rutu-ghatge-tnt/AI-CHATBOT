# ── HLHP UI environment ────────────────────────────────────────────────
# Copy to `.env.local` and adjust. All values are read in api/hlhpClient.ts.

# Master switch. "true" (default) = everything is mocked client-side, no
# network. Set to "false" to call a live backend (see README swap guide).
NEXT_PUBLIC_USE_MOCK=true

# Base URL of the FastAPI server (only used when USE_MOCK=false).
# Routes are under /api/hlhp/* — e.g. http://localhost:8000
NEXT_PUBLIC_API_BASE=http://localhost:8000

# Demo identity / location (also used to seed the mock).
NEXT_PUBLIC_USER_ID=demo-user
NEXT_PUBLIC_CITY=Baner
NEXT_PUBLIC_LAT=18.56
NEXT_PUBLIC_LNG=73.78
